APP_NAME=Search Console Agent
DEBUG=false

# Set this to the public backend URL after deploy.
APP_URL=https://your-backend-domain.example

# Set this to the deployed frontend URL.
FRONTEND_URL=https://your-frontend-domain.example

# Managed platforms usually provide these automatically when you attach
# PostgreSQL and Redis services. Keep the provider values if present.
DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://default:password@host:6379

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-domain.example/api/v1/auth/google/callback

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=30

GROQ_API_KEY=your-groq-api-key
LLM_MODEL_ID=groq/openai/gpt-oss-120b
MISTRAL_API_KEY=
PAGESPEED_API_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Search Console Agent
ADMIN_EMAIL=admin@example.com

SCHEDULER_ENABLED=true
DAILY_REPORT_TIME=08:00

FASTN_API_BASE_URL=https://api.fastn.dev
FASTN_WORKFLOW_ID=wf_3dd1351b36da
FASTN_DESTINATIONS_WORKFLOW_ID=wf_84cad8eacfc8
FASTN_WIDGET_ID=wgt_e50e98094782
FASTN_API_KEY=
FASTN_AUTH_HEADER=Authorization
FASTN_AUTH_SCHEME=Bearer
FASTN_TENANT_HEADER=x-end-org-id
FASTN_INSTALLATION_HEADER=x-installation-id
FASTN_TIMEOUT_SECONDS=30

# Coding agent
CODING_AGENT_ENABLED=true
# The customer repository is read from that user's selected site settings.
# Optional only for an offline test fixture; it is verified against the saved repo.
CODING_AGENT_TEST_REPOSITORY_ROOT=
CODING_AGENT_ENVIRONMENT=production
CODING_AGENT_SANDBOX_PROVIDER=daytona
CODING_AGENT_PREVIEW_ROOT=.coding-agent/previews
CODING_AGENT_TEST_ALLOWED_PATHS=index.html,home.html,homepage.html,public/index.html,pages/index.md,pages/index.mdx,pages/index.html,app/page.md,app/page.mdx,app/page.html,src/app/page.md,src/app/page.mdx,src/app/page.html
CODING_AGENT_GITHUB_BASE_BRANCH=main
CODING_AGENT_GITHUB_TOKEN=
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
DAYTONA_SANDBOX_NAME_PREFIX=SEO_agent_sandbox
DAYTONA_SANDBOX_AUTO_STOP_MINUTES=15
DAYTONA_SANDBOX_AUTO_ARCHIVE_MINUTES=10080
DAYTONA_SANDBOX_EPHEMERAL=true
