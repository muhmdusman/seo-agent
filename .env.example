# Safe production template for Search Console Agent.
# Do not commit real secrets. In ECS, inject sensitive values from AWS Secrets Manager.

# Application
APP_NAME="Search Console Agent"
DEBUG=false
APP_URL="https://YOUR_API_GATEWAY_ID.execute-api.us-east-1.amazonaws.com"
FRONTEND_URL="https://YOUR_FRONTEND_DOMAIN.amplifyapp.com"

# Amplify/Next.js server-side rewrite target. Keep this private/build-time;
# browser code calls the same-origin /api/v1 path.
NEXT_PUBLIC_API_BASE_URL="/api/v1"
BACKEND_API_URL="https://YOUR_API_GATEWAY_ID.execute-api.us-east-1.amazonaws.com/api/v1"

# Data stores
DATABASE_URL="postgresql+psycopg://DB_USER:DB_PASSWORD@RDS_HOST:5432/app_db"
REDIS_URL="rediss://VALKEY_HOST:6379/0"

# Google OAuth / Search Console
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://YOUR_FRONTEND_DOMAIN.amplifyapp.com/api/v1/auth/google/callback"

# Application tokens
JWT_SECRET="generate-a-long-random-production-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7

# Active model path in the current code
LLM_MODEL_ID="groq/openai/gpt-oss-120b"
GROQ_API_KEY="your-groq-api-key"

# AWS Bedrock production option. The ECS task role should grant Bedrock
# inference permissions; no Bedrock API key belongs in this file.
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID="us.amazon.nova-lite-v1:0"
# To select Bedrock after its LiteLLM/provider wiring is enabled:
# LLM_MODEL_ID="bedrock/us.amazon.nova-lite-v1:0"

# Optional legacy provider supported by the current selector
# MISTRAL_API_KEY="your-mistral-api-key"

# Coding-agent sandbox provider. Keep `local` for a Git worktree on the host.
# Set to `daytona` only after creating a Daytona account/API key (free-start
# availability is subject to Daytona's current plan and account limits).
CODING_AGENT_SANDBOX_PROVIDER="local"
# The customer repository is selected per site and stored in the database.
# Optional local fixture checkout for offline test runs only.
CODING_AGENT_TEST_REPOSITORY_ROOT=""
CODING_AGENT_ENVIRONMENT="test"
CODING_AGENT_PREVIEW_ROOT=".coding-agent/previews"
CODING_AGENT_TEST_ALLOWED_PATHS="index.html,home.html,homepage.html,public/index.html,pages/index.md,pages/index.mdx,pages/index.html,app/page.md,app/page.mdx,app/page.html,src/app/page.md,src/app/page.mdx,src/app/page.html"
CODING_AGENT_GITHUB_BASE_BRANCH="main"
CODING_AGENT_GITHUB_TOKEN=""
DAYTONA_API_KEY=""
DAYTONA_API_URL="https://app.daytona.io/api"
DAYTONA_TARGET=""
DAYTONA_SANDBOX_NAME_PREFIX="SEO_agent_sandbox"
DAYTONA_SANDBOX_AUTO_STOP_MINUTES=15
DAYTONA_SANDBOX_AUTO_ARCHIVE_MINUTES=10080
DAYTONA_SANDBOX_EPHEMERAL=true

# SEO analysis budget
SEO_DEMO_MODE=false
SEO_PROMPT_CHAR_BUDGET=0

# PageSpeed / Core Web Vitals tool integration (being added)
PAGESPEED_API_KEY="your-pagespeed-api-key"

# Email delivery for scheduled reports
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@example.com"
SMTP_PASSWORD="your-smtp-app-password"
SMTP_FROM_EMAIL="your-email@example.com"
SMTP_FROM_NAME="Search Console Agent"

# Scheduler
SCHEDULER_ENABLED=true
DAILY_REPORT_TIME="08:00"
ADMIN_EMAIL="your-email@example.com"
